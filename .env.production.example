# Production environment — AI Video editor engine (standalone droplet)
#
# Copy to `.env` on the droplet. NEVER commit real secrets.
# Remotion Lambda must already be deployed (function + site).

NODE_ENV=production
PORT=8090
LOG_LEVEL=info

# Never bypass auth in production
DEV_AUTH_BYPASS=0

# Optional: require header `x-engine-key: <value>` from the app
ENGINE_API_KEY=

# Public URL of THIS service (DNS → nginx → :8090)
ENGINE_PUBLIC_BASE_URL=https://engine.kinmel.shop

# --- Speech (Groq) ----------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
GROQ_MAX_UPLOAD_MB=24
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Director / stock -------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SEEDANCE_MODEL=bytedance/seedance-2.0-mini
BROLL_ENABLED=1
BROLL_MOMENT_COUNT=5
BROLL_CLIP_DURATION_SEC=2.4

# --- Cloudflare R2 (source + output media) ----------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Remotion Lambda (burn) — AWS worker IAM user ---------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=us-east-1
REMOTION_FUNCTION_NAME=remotion-render-4-0-524-mem3008mb-disk10240mb-240sec
REMOTION_SERVE_URL=https://remotionlambda-useast1-y6udh18lk5.s3.us-east-1.amazonaws.com/sites/kinmel-video-engine/index.html
REMOTION_COMPOSITION_ID=ShortVideo
REMOTION_FRAMES_PER_LAMBDA=120

# --- Limits -----------------------------------------------------------------
MAX_ANALYSES_PER_USER_MONTH=250
MAX_RENDER_MINUTES_PER_USER_MONTH=90
MAX_SOURCE_DURATION_SEC=300

# Leave blank unless you run Redis
REDIS_URL=
BLUEPRINT_TTL_SEC=604800
