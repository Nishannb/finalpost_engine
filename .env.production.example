# Production environment — AI Video editor engine (standalone droplet)
#
# Copy to `.env` on the droplet. NEVER commit real secrets.
# Remotion Lambda must already be deployed (function + site).

NODE_ENV=production
PORT=8090
LOG_LEVEL=info

# Never bypass auth in production
DEV_AUTH_BYPASS=0

# Optional: require header `x-engine-key: <value>` from the app
ENGINE_API_KEY=

# Creators Flask API — engine POSTs /creator/internal/edit-done so the phone
# can get a remote push after captions finish (user may have left the app).
# CREATOR_API_URL=https://api.kinmel.shop
CREATOR_API_URL=

# Creators Supabase project — required for mobile Bearer tokens (ES256 JWKS)
SUPABASE_URL=https://mmyprzatmrfdtodsqaia.supabase.co
# Public anon key (same as app) — Auth /user fallback if JWKS fails
SUPABASE_ANON_KEY=
# Optional fallback if any tokens still use HS256 (Legacy JWT Secret)
SUPABASE_JWT_SECRET=

# Public URL of THIS service (DNS → nginx → :8090)
ENGINE_PUBLIC_BASE_URL=https://engine.kinmel.shop

# --- Speech (Groq) ----------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
GROQ_MAX_UPLOAD_MB=24
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Output frame rate --------------------------------------------------------
# Approved initial production setting: every edit renders at 30 fps (a 24 fps source is resampled to 30,
# which is the behaviour before frame-rate matching existed). The code default is `source` (keep
# 23.976 / 24 / 25 / 29.97, convert 15 / 50 / 60 / unknown to 30): do not switch to it until a
# fractional-rate Lambda render has been checked. Setting this on the host is the operator's change.
OUTPUT_FPS_MODE=fixed30

# --- Director / stock -------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# AI Template Designer (reference video → EditSpec → Alan black-screen preview)
# Optional — defaults match these values if omitted
# GEMINI_TEMPLATE_DESIGNER_MODEL=gemini-3.6-flash
# TEMPLATE_DESIGNER_FRAME_INTERVAL_SEC=1
# TEMPLATE_DESIGNER_MAX_FRAMES=24
PEXELS_API_KEY=
PIXABAY_API_KEY=
# WP15: KLIPY GIF/sticker overlays (Partner Panel app key). Confirm server-side use with KLIPY.
# KLIPY_APP_KEY=
# WP52: default OFF (unrelated stickers overlapped stills). Set 1 only when deliberately testing stickers.
# KLIPY_OVERLAYS_ENABLED=1
# KLIPY_MAX_SEARCHES_PER_EDIT=8
OPENROUTER_API_KEY=
OPENROUTER_SEEDANCE_MODEL=bytedance/seedance-2.0-mini
BROLL_ENABLED=1
# lean (default): captions + auto-trim + auto-zoom + hook title. Visual toolkits stay in the repo.
PIPELINE_MODE=lean
BROLL_MOMENT_COUNT=5
BROLL_CLIP_DURATION_SEC=2.4
# DIRECTOR_V2=0
# NORTH_STAR=0
# DELIVERY_SHAPING_AUTO=1
# DELIVERY_LLM_EMPHASIS=0

# --- Cloudflare R2 (source + output media) ----------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Remotion Lambda (burn) — AWS worker IAM user ---------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=us-east-1
REMOTION_FUNCTION_NAME=remotion-render-4-0-524-mem3008mb-disk10240mb-240sec
REMOTION_SERVE_URL=https://remotionlambda-useast1-y6udh18lk5.s3.us-east-1.amazonaws.com/sites/kinmel-video-engine/index.html
REMOTION_COMPOSITION_ID=ShortVideo
REMOTION_FRAMES_PER_LAMBDA=120

# --- Limits -----------------------------------------------------------------
MAX_ANALYSES_PER_USER_MONTH=250
MAX_RENDER_MINUTES_PER_USER_MONTH=90
MAX_SOURCE_DURATION_SEC=300

# Leave blank unless you run Redis
REDIS_URL=
BLUEPRINT_TTL_SEC=604800

# --- mvp product profile, per-edit budgets, ingest safety (all optional and commented; unset = today's behaviour; same notes as .env.example) ---
# PRODUCT_EDIT_PROFILE=mvp        # explicit opt-out to the mvp profile (only the exact string "mvp"; case-sensitive, surrounding spaces are trimmed): whole-video Director, opening plan, creator-B-roll-only, legibility rules. Not the default. Not settable by API callers.
# PRODUCT_EDIT_PROFILE=legacy     # explicit opt-out to the pre-WP1 behaviour (only the exact string "legacy"; its cache keys are the old ones). Not the default.
# PRODUCT_EDIT_PROFILE=cuts       # THE DEFAULT (since WP7C): cuts-first. Unset, empty or any unrecognized value (a typo) resolves to cuts and logs a warning. Silence + filler trim, transcript retake/restart/self-correction trim and background-noise reduction; skips the visual Director, B-roll, generated and motion graphics, and delivery shaping. Set PRODUCT_EDIT_PROFILE=legacy or mvp only to opt out.
# PRODUCT_EDIT_PROFILE=polish     # opt-in (WP8A, the exact string "polish"): Stage A = everything the cuts profile does to the speech (denoise, AI keep-plan, fluency scrub, retakes, forced trim), THEN Stage B = the mvp visual editor (Director, toolkits, captions); generated graphics stay off unless MOTION_GRAPHICS_ENABLED is on. Not the default; cuts stays the default.
# CUTS_DENOISE_ENABLED=true       # cuts profile only: reduce background noise on the talking-head audio (afftdn). false cuts without denoising. A failed denoise warns (cuts_denoise_failed) and keeps the original audio.
# CUTS_DENOISE_NR_DB=12           # cuts profile only: noise reduction in dB (clamped 4-30). Gentle by default; high values make speech sound watery.
# CUTS_DENOISE_HIGHPASS_HZ=80     # cuts profile only: high-pass cutoff in Hz for rumble and hum (clamped 40-200).
# MOTION_GRAPHICS_ENABLED=        # generated Gemini-directed, Claude-built motion graphics. OFF by default (unset). Needs ANTHROPIC_API_KEY. On the mvp profile it also needs a positive CLAUDE_EDIT_BUDGET_USD, otherwise graphics stay off.
# CLAUDE_EDIT_BUDGET_USD=         # hard per-edit cap on estimated Claude spend (dollars). No default on purpose. With the mvp profile and MOTION_GRAPHICS_ENABLED=true, unset/0 switches generated graphics OFF and the job records claude_graphics_disabled:claude_budget_unconfigured (a negative value also switches them off: ...:claude_budget_invalid).
# CLAUDE_EDIT_MAX_REQUESTS=       # optional; default = graphics cap x (1 + repair attempts)
# CLAUDE_EDIT_MAX_TOKENS=         # optional per-call output ceiling (>= 4000, default 12000)
# INGEST_ALLOWED_PRIVATE_HOSTS=   # default empty: loopback, link-local, private and cloud-metadata addresses are always refused. Exact hostnames only, comma separated.
# GEMINI_EDIT_MAX_REQUESTS=       # max Gemini HTTP attempts in ONE analyze job, retries included. At the cap no further request is sent; stages use their fallbacks and the job finishes.
#                                 # UNSET OR 0 MEANS NO CAP (Gemini attempts are unbounded). On PRODUCT_EDIT_PROFILE=mvp the job then records the warning gemini_edit_budget_unconfigured;
#                                 # it is only a warning (the job is NOT refused). Set a positive request count before any paid run. A negative value fails closed (no Gemini request at all); a non-numeric value is read as unset (0 = no cap), so check the number.

# --- polish production trial (all optional and commented; unset = today's default, cuts; the HTTP analyze path and first-video read the SAME variables) ---
# PRODUCT_EDIT_PROFILE=polish     # (see the polish line above) the HTTP product path then runs the same stack as first-video: speech cuts, then the Edit Look Director.
# POLISH_DEFAULT_EDITS=lean       # polish only: what is edited when the request / CLI names no edits. lean (default) = captions + zoom + hook title, kinetic text, lockup, card, bubble, emphasis, counter (no stock B-roll search); all = every toolkit (creator B-roll stays user-only).
# MOTION_GRAPHICS_ENABLED=1       # polish: with no Claude bound the motion stage runs LIBRARY-ONLY (ready-made compositions, no Claude call, job graphics status "library_only"); unset/0 = no generated graphics.
# GEMINI_EDIT_MAX_REQUESTS=8      # per-edit Gemini attempt cap; polish reserves slots for the keep-plan, Director v2 and the motion Director (occupancy gets one attempt). Below 4 starves the motion Director.
# CLAUDE_EDIT_BUDGET_USD=         # needed ONLY if you want Claude to build graphics the library cannot (then also set a request cap). Library-only polish needs no Claude key.
# POLISH_SUBJECT_STAGE=0          # polish only (default OFF): Subject Stage edit style - the RVM speaker is fixed and editing happens on stages behind her (plate / card / ghost scroll / accents) and once in front (S5). Needs the RVM matte over the whole run (mps / cuda, or CPU for <= 45 s); else off. Wins over POLISH_KINETIC_LED. Not read by analyze yet.

# --- Pro / Pro Plus full edit: server-side plan enforcement + durable jobs (placeholders only) -----------------
# The plan is resolved by the Creators API (CREATOR_API_URL + ENGINE_API_KEY above), never taken from the phone.
# Full AI edit routes are refused unless the creator is verified Pro / Pro Plus. Set to 0 ONLY for local development.
# ENTITLEMENT_ENFORCEMENT=1
# Durable full-edit job table (public.creator_edit_jobs, migration 20261105120000). Server-only key; never ship to a client.
# SUPABASE_SERVICE_ROLE_KEY=
# Retention: inactive jobs are marked expired after this many days; finished jobs are deleted after the second value.
# EDIT_JOB_INACTIVE_DAYS=30
# EDIT_JOB_TERMINAL_DAYS=90

# --- Edit-style picker (server/src/lib/editStyles.ts) ---------------------------------------------------------------
# Kill switch, default off: GET /v1/edit-styles answers 404 and `style` is ignored (the app falls back to mode-only requests).
# EDIT_STYLES_ENABLED=1
# Comma lists of style ids. Empty = registry defaults. Example: basic_captions,ai_clean_cut
# EDIT_STYLES_AVAILABLE=
# EDIT_STYLES_ORDER=
# Phase 2 engine kill switch, default off: styled jobs run as in Phase 1 (Kinetic / Explainer as AI Clean Cut, marked degraded).
# 1 = per-style pipeline flags and Gemini caps (server/src/lib/styleRun.ts). Requests without a style are unaffected.
# EDIT_STYLES_ENGINE_FLAGS=1

# ---- V1 release (Free Basic Captions + Pro Kinetic Typography). Names only; values are set on the host, never committed. ----
# V1 release gate, default OFF. ON: only basic_captions and kinetic_typography are startable, Kinetic V2 + the Match Cut shutter run for the Kinetic style,
# and a Kinetic job that does not produce its Kinetic V2 edit FAILS (retryable kinetic_unavailable). OFF: a Kinetic Typography request is refused (kinetic_unavailable).
# V1_KINETIC_RELEASE=1
# Who may start Kinetic while the release flag is ON. FAILS CLOSED: set the access mode BEFORE turning V1_KINETIC_RELEASE on.
#   V1_KINETIC_ACCESS=entitlement  production mode. Kinetic requires an active paid Pro or Pro Plus subscription.
#                                  The Creators API must return source=revenuecat with plan=pro or plan=pro_plus. source=nepal_verified is refused.
#                                  Expired and cancelled subscriptions arrive as plan=free and are refused. A failed lookup is refused.
#                                  V1_KINETIC_ALLOWED_USER_IDS is ignored. Leave it unset. An empty or malformed list does not grant access and does not fail this mode.
#                                  The lookup runs on create, retry, asset submit, the catalog, and the worker, including service-key and dev.
#                                  ENTITLEMENT_ENFORCEMENT=0 does not skip the Kinetic check. There is no account UUID allowlist.
#   V1_KINETIC_ACCESS=allowlist    optional narrower gate. V1_KINETIC_ALLOWED_USER_IDS is then a comma-separated UUID list (server env only; never committed, logged or returned).
#                                  Unset/empty = nobody. ONE malformed entry (or a stray comma) voids the whole list = nobody. Pro is still required.
#   Unset, empty or unknown = nobody. `all` is refused when NODE_ENV=production (development/tests only).
# Enforced at POST /v1/edits/captions, GET /v1/edit-styles (allowlist: Kinetic shown unavailable; entitlement: listed, and locked unless the subscription is paid),
# POST /v1/edits/:id/retry and /assets (an existing Kinetic job does not outlive its owner's access).
# Invalid config with the release on: startup logs an ERROR (no ids) and Kinetic is refused for everyone; Free Basic Captions are unaffected.
# V1_KINETIC_ACCESS=entitlement
# V1_KINETIC_ALLOWED_USER_IDS=
# Durable job store for Pro edits (public.creator_edit_jobs, migration 20261105120000_creator_edit_jobs.sql). REQUIRED in production: without it every full_edit is refused (not_configured).
# SUPABASE_SERVICE_ROLE_KEY=
# Automatic recovery worker. Independent of the durable store above: the service-role key still persists full edits when this is off.
# Unset or 0 (the default): do not schedule the 5-second boot scan, the minute stalled-job and pending-callback scan, or the daily retention purge.
# New jobs, uploads, user-triggered retries, and entitlement checks keep working. 1 = start that worker. A change needs a process restart.
# FULL_EDIT_RECOVERY_ENABLED=0
# Plan lookups go to the Creators API (CREATOR_API_URL + ENGINE_API_KEY). Leave enforcement on.
# ENTITLEMENT_ENFORCEMENT=1
# Edit styles on (the picker catalog and the `style` field). V1_KINETIC_RELEASE forces them on for the two V1 styles.
# EDIT_STYLES_ENABLED=1
# EDIT_STYLES_ENGINE_FLAGS=1
# Subject Stage as its OWN picker option next to Kinetic Typography (default OFF; leave unset until the staged rollout in docs/RVM_SUBJECT_STAGE_PLAN.md; needs the host RVM, docs/RVM_HOST.md; no GPU => clips <= 45 s only).
# SUBJECT_STAGE_PICKER=0
# Never in production: DEV_AUTH_BYPASS, STORAGE_BACKEND=local, POLISH_KINETIC_ENGINE_MATTE, POLISH_SUBJECT_STAGE, POLISH_KINETIC_ENGINE_3D.

# Completion callbacks to the Creators API (names only; defaults shown). Set CALLBACK_MAX_ATTEMPTS=1 to disable retries without a code change.
# CALLBACK_MAX_ATTEMPTS=5
# CALLBACK_BACKOFF_BASE_MS=1000
# CALLBACK_BACKOFF_MAX_MS=30000
# CALLBACK_TIMEOUT_MS=12000

# V1 Pro Kinetic Typography (what the app's full edits request). Without these the engine refuses the Kinetic request
# with `kinetic_unavailable` (since 2026-11-26; before that it silently ran a plain full_edit with no Kinetic V2 and no B-roll asks).
# V1_KINETIC_RELEASE=1             # routes style kinetic_typography to the Kinetic V2 pipeline (implies the style catalog)
# V1_KINETIC_ACCESS=entitlement    # set BEFORE the release flag: active paid Pro / Pro Plus only (fail closed)
# EDIT_STYLES_ENGINE_FLAGS=1       # default on; 0 refuses Kinetic
# POLISH_KINETIC_COMPOSER=1        # beat Composer: full-frame layouts, every word captioned, AI colours, AI text-behind / Match Cut suggestions. Off = plain V2 engine

# Speaker cutout (RVM) for Kinetic text behind the speaker. Set up the host first: ./deploy/setup-rvm.sh (see docs/RVM_HOST.md).
# CPU measured 2026-11-26: ~0.5 s per 1080x1920 frame on one Apple M1 core (a 30 s clip ~7-8 min); a shared droplet vCPU is slower. Plan a GPU before turning this on for everyone.
# POLISH_KINETIC_ENGINE_MATTE=1
# RVM_PYTHON=/opt/finalpost/rvm/venv/bin/python
# RVM_WEIGHTS_PATH=/opt/finalpost/rvm/rvm_mobilenetv3.pth
# RVM_DEVICE=cpu
# PERSON_MATTE_CACHE_DIR=/opt/finalpost/rvm/cache
# MATTING_MAX_CONCURRENT=1
# MATTING_TIMEOUT_SEC=900
