        "content": {
          "label": "Annual revenue",
          "currency": "$",
          "unit": "M",
          "from": 2,
          "to": 10,
          "years": [
            "2020",
            "2021",
            "2022",
            "2023",
            "2024",
            "2025"
          ],
          "series": [
            2,
            2.8,
            3.9,
            5.6,
            7.4,
            10
