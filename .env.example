# Absolute minimum for local first-video.
# In the monorepo, R2 keys can also be loaded from ../server/.env.
# On a standalone droplet, put ALL secrets in this file (see .env.production.example).

NODE_ENV=development
PORT=8090
DEV_AUTH_BYPASS=1

# Production / non-bypass: project URL for ES256 JWKS verification
# SUPABASE_URL=https://mmyprzatmrfdtodsqaia.supabase.co
# SUPABASE_JWT_SECRET=  # legacy HS256 only

# Phone downloads local-fallback renders from this base (same as VIDEO_ENGINE_BY_ENV.dev).
ENGINE_PUBLIC_BASE_URL=http://192.168.1.35:8090

# Creators Flask API (edit-done push). Local: http://127.0.0.1:8080
# CREATOR_API_URL=http://127.0.0.1:8080
# ENGINE_API_KEY=

GROQ_API_KEY=
GEMINI_API_KEY=
# Medium model for AI Template Designer (reference → EditSpec). Keep cheaper than Pro.
# GEMINI_TEMPLATE_DESIGNER_MODEL=gemini-3.6-flash
# TEMPLATE_DESIGNER_FRAME_INTERVAL_SEC=1
# TEMPLATE_DESIGNER_MAX_FRAMES=24
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Dev: force speaker cutout over B-roll (also: npm run first-video -- ... --cutout)
# FORCE_SPEAKER_CUTOUT=1
# Free multi-stage director (Stages 0/1/2/4). Off by default.
# lean (default): captions + auto-trim + auto-zoom + hook title.
# Visual toolkits stay in the repo; pass --edits= or PIPELINE_MODE=full to use them.
# PIPELINE_MODE=lean
# DIRECTOR_V2=1
# Opt-in north-star compositor (Director v2 + plate contrast + SFX). Also: --north-star
# NORTH_STAR=1
# Local acoustic/rule planner may apply delivery_shaping when --edits is omitted.
# DELIVERY_SHAPING_AUTO=1
# Optional transcript-only LLM emphasis proposals (default off).
# DELIVERY_LLM_EMPHASIS=0

OPENROUTER_API_KEY=
# Template-driven edit (OpenRouter Video API)
OPENROUTER_SEEDANCE_MODEL=bytedance/seedance-2.0-mini

# R2 — required on standalone droplet (optional locally if ../server/.env exists)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Optional. Leave blank — first videos render on this Mac, then upload to R2.
# Fill after docs/remotion-lambda-deploy.md (function + site deploy).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=us-east-1
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=
REMOTION_COMPOSITION_ID=ShortVideo
REMOTION_FRAMES_PER_LAMBDA=120
# REMOTION_S3_OUTPUT_BUCKET=
