{
  "name": "@kinmel/video-engine-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "first-video": "node --experimental-strip-types src/scripts/firstVideo.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "^3.890.0",
    "@aws-sdk/client-s3": "^3.890.0",
    "@aws-sdk/s3-request-presigner": "^3.890.0",
    "@remotion/lambda": "4.0.524",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "pino": "^10.0.0",
    "redis": "^5.10.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
