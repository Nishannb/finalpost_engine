{
  "name": "@kinmel/video-engine-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "first-video": "node --experimental-strip-types src/scripts/firstVideo.ts",
    "render-blueprint": "node --experimental-strip-types src/scripts/renderBlueprint.ts",
    "eval:director-v2": "node --experimental-strip-types src/scripts/evalDirectorV2.ts",
    "eval:template-designer": "node --experimental-strip-types src/scripts/evalTemplateDesigner.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mg:fixture": "node --experimental-strip-types src/scripts/mgFixture.ts",
    "mg:worker": "node --experimental-strip-types src/scripts/mgWorker.ts",
    "mg:e2e": "node --experimental-strip-types src/scripts/mgE2E.ts",
    "ledger": "node --experimental-strip-types src/scripts/ledgerSummary.ts",
    "eval:replay": "vitest run src/eval",
    "eval:baseline": "node --experimental-strip-types src/eval/baselineCli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@aws-sdk/client-iam": "^3.890.0",
    "@aws-sdk/client-s3": "^3.890.0",
    "@aws-sdk/s3-request-presigner": "^3.890.0",
    "@remotion/bundler": "4.0.524",
    "@remotion/lambda": "4.0.524",
    "@remotion/renderer": "4.0.524",
    "dotenv": "^17.2.3",
    "esbuild": "0.28.1",
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "pino": "^10.0.0",
    "redis": "^5.10.0",
    "typescript": "^5.8.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.0",
    "vitest": "^3.2.4"
  }
}
